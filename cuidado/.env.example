# Conexión directa de Postgres. El pooler en modo transacción no sostiene el candado del diagnóstico.
DATABASE_URL=postgresql://user:pass@host/cuidado?sslmode=require
AUTH_SECRET=replace-with-openssl-rand-base64-32
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
GOOGLE_PSI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_PRIVATE_URLS=false
APP_URL=https://cuidadoweb.com
