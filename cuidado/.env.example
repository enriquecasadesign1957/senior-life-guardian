AUTH_SECRET=replace-with-openssl-rand-base64-32
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
GOOGLE_PSI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
LEMON_RESCATE_BUY_URL=https://cuidadoweb.lemonsqueezy.com/checkout/buy/35068710-f9df-4e18-9b56-0799919ebeb7
LEMON_PLAN_BUY_URL=https://cuidadoweb.lemonsqueezy.com/checkout/buy/863035d4-2383-4db7-a162-b2409e600ef4
LEMON_RESCATE_VARIANT_ID=2318074
LEMON_PLAN_VARIANT_ID=2318120
LEMON_SQUEEZY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Transbank Chile (Webpay Plus + Oneclick Mall). Sandbox por defecto si TRANSBANK_ENVIRONMENT!=production.
TRANSBANK_ENVIRONMENT=sandbox
TRANSBANK_CC=
TRANSBANK_API_KEY=
TRANSBANK_ONECLICK_MALL_CC=
TRANSBANK_ONECLICK_STORE_CC=
TRANSBANK_ONECLICK_API_KEY=
