{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cuidadoweb": {
      "root": "cuidado/apps/web",
      "framework": "nextjs",
      "installCommand": "npm install --prefix ../..",
      "buildCommand": "npm run build --prefix ../.. --workspace @cuidado/web",
      "ignoreCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && git diff --quiet HEAD^ HEAD -- ./cuidado ./vercel.json'"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "cuidadoweb"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/watch",
      "schedule": "0 14 * * *"
    }
  ]
}
