{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cuidadoweb": {
      "root": "cuidado/apps/web",
      "framework": "nextjs",
      "installCommand": "npm install --prefix ../.."
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "cuidadoweb"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/watch",
      "schedule": "*/15 * * * *"
    }
  ]
}
