{
  "compatibility_date": "2025-09-24",
  "name": "alarmaseniorsafe-com",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "alarmaseniorsafe.com/*",
      "zone_name": "alarmaseniorsafe.com"
    },
    {
      "pattern": "www.alarmaseniorsafe.com/*",
      "zone_name": "alarmaseniorsafe.com"
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://alarmaseniorsafe.com",
    "TWILIO_WHATSAPP_COMMERCIAL_FROM": "56971404580"
  },
  "main": "index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "../client"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ]
}
