function generateValidationBuyOrders(prefix) {
  const suffix = Date.now().toString(36).toUpperCase().replace(/[^A-Z0-9]/g, "").slice(-8);
  let mallBuyOrder = `${prefix}${suffix}`.slice(0, 26);
