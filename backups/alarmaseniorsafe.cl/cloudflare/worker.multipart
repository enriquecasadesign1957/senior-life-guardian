}
async function sendResetEmail(to, nombre, code) {
  const subject = "Senior Safe — código para recuperar tu PIN";
  const textBody = `Hola ${nombre},

Recibimos una solicitud para crear un PIN nuevo en Senior Safe.

Tu código es: ${code}

Expira en ${CODE_TTL_MIN} minutos. Si no solicitaste esto, ignora este correo.

Equipo Senior Safe`;
  const htmlBody = wrapSupportHtmlReply(
    `Recibimos una solicitud para crear un PIN nuevo en Senior Safe.

Tu código de verificación es:

${code}

Expira en ${CODE_TTL_MIN} minutos. Si no solicitaste esto, ignora este correo.`,
