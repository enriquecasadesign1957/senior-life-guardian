    throw new Error("Zoho SMTP no configurado (ZOHO_SMTP_USER / ZOHO_SMTP_PASSWORD)");
  }
  const mime = buildMimeMessage(input, cfg);
  const bccList = collectBccRecipients(cfg, input.bcc);
  await new Promise((resolve, reject) => {
    const socket = cfg.secure ? tls.connect({ host: cfg.host, port: cfg.port, servername: cfg.host }) : null;
