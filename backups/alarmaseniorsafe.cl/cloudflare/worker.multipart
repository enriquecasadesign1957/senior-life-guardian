  for (const turn of history) {
    messages.push({ role: turn.role, content: turn.content });
  }
  const lastTurn = history[history.length - 1];
  const alreadyHasCurrentUser = lastTurn?.role === "user" && lastTurn.content.trim() === userMessage.trim();
