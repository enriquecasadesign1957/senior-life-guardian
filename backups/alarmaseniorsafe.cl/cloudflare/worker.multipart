const CANCELLATION_POLICY_MONTHLY = "Plan mensual: no hay reembolso ni cargo extra después de cancelar el plan.";
const CANCELLATION_POLICY_ANNUAL = "Plan anual: por ser un plan con descuento adicional, no hay reembolso ni cargo adicional después de cancelar o dar de baja el plan.";
const CANCELLATION_POLICY_BULLETS = [
  CANCELLATION_POLICY_GENERAL,
  CANCELLATION_POLICY_MONTHLY,
